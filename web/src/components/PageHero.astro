---
// Blue intro banner shared by the section landing pages; same look as the Thi thử hero (.exam-intro).
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

type Props = {
  kicker: string;
  kickerIcon: IconName;
  title: string;
  highlight: string;
  lead: string;
  facts: { icon: IconName; label: string }[];
  ticket: { label: string; icon: IconName; title: string; note: string };
  ringIcon: IconName;
};
const { kicker, kickerIcon, title, highlight, lead, facts, ticket, ringIcon } = Astro.props;
---

<div class="exam-intro page-hero">
  <div class="exam-intro-copy">
    <p class="exam-kicker"><Icon name={kickerIcon} size={16} /> {kicker}</p>
    <h1>{title}<br /><span>{highlight}</span></h1>
    <p>{lead}</p>
    <div class="exam-intro-facts">{facts.map((f) => <span><Icon name={f.icon} size={17} /> {f.label}</span>)}</div>
  </div>
  <div class="exam-intro-art" aria-hidden="true">
    <div class="exam-intro-ring"><Icon name={ringIcon} size={145} /></div>
    <div class="exam-intro-ticket">
      <span><Icon name={ticket.icon} size={19} /> {ticket.label}</span>
      <strong set:html={ticket.title} />
      <small>{ticket.note}</small>
    </div>
  </div>
</div>
