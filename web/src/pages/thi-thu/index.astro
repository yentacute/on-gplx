---
import Base from '../../layouts/Base.astro';
import ExamTab from '../../components/ExamTab.astro';
import { CAR_CLASSES } from '../../lib/data';
import { DEFAULT_CLASS } from '../../lib/progress';

// The tab opens straight on the exam list. It is rendered for the default class; a learner who picked
// another class is sent to that class's page before anything paints.
const c = CAR_CLASSES.find((x) => x.id === DEFAULT_CLASS)!;
---

<Base
  title="Thi thử lý thuyết lái xe ô tô online, chấm điểm như thi thật"
  description="Thi thử lý thuyết bằng lái ô tô hạng B, C1, C, D1, D2, D và các hạng kéo rơ-moóc: đề bấm giờ, chấm điểm, có câu điểm liệt, xem lại đáp án sau khi nộp bài."
  trail={[{ name: 'Thi thử', path: '/thi-thu' }]}
>
  <script is:inline define:vars={{ fallback: DEFAULT_CLASS }}>
    try {
      const id = JSON.parse(localStorage.getItem('gplx.class') || 'null');
      if (typeof id === 'string' && id !== fallback && /^[A-Z0-9]{1,4}$/.test(id)) location.replace('/thi-thu/hang-' + id.toLowerCase());
    } catch {}
  </script>
  <ExamTab c={c} />
</Base>
