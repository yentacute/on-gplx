---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { ExamScoreBadge, RememberClass } from '../../components/HomeIslands';
import { CAR_CLASSES, CHAPTERS, LANDING_CLASSES, fixedExams, paths } from '../../lib/data';
import { classFaq, courseLd, faqLd } from '../../lib/faq';
import type { LicenseClass } from '../../lib/types';

export const getStaticPaths = () =>
  CAR_CLASSES.map((c) => ({ params: { cls: `hang-${c.id.toLowerCase()}` }, props: { c } }));

const { c } = Astro.props as { c: LicenseClass };
const landing = LANDING_CLASSES.some((x) => x.id === c.id);
const exams = fixedExams(c);
const faq = classFaq(c);
const path = paths.licenseClass(c.id);
const heading = `Thi thử lý thuyết lái xe hạng ${c.id}`;
const description = `Thi thử lý thuyết bằng lái hạng ${c.id} (${c.title.toLowerCase()}): ${c.exam.questionCount} câu, ${c.exam.timeMinutes} phút, cần đúng ${c.exam.passingScore} câu. 20 đề có đáp án và đề ngẫu nhiên từ bộ 600 câu.`;
const facts = [
  { value: c.exam.questionCount, label: 'Câu hỏi' },
  { value: `${c.exam.timeMinutes} phút`, label: 'Thời gian' },
  { value: `${c.exam.passingScore}/${c.exam.questionCount}`, label: 'Điểm đạt' },
  { value: `${c.minAge}+`, label: 'Tuổi tối thiểu' },
];
---

<Base
  title={`${heading}: ${c.exam.questionCount} câu, ${c.exam.timeMinutes} phút`}
  description={description}
  noindex={!landing}
  trail={[{ name: 'Thi thử', path: '/thi-thu' }, { name: `Hạng ${c.id}`, path }]}
  jsonLd={[courseLd(`Ôn thi lý thuyết lái xe hạng ${c.id}`, description, `${Astro.site!.origin}${path}`), faqLd(faq)]}
>
  <RememberClass client:load id={c.id} />
  <section class="container-page exam-class-page">
    <div class="exam-class-hero">
      <div class="exam-class-hero-main">
        <span class="exam-class-hero-badge">BẰNG LÁI HẠNG {c.id}</span>
        <h1>{heading}</h1>
        <p>{c.title} · {c.description}</p>
        <div class="exam-class-hero-actions">
          <a href={paths.exam(c.id, 'ngau-nhien')} class="btn exam-hero-primary"><Icon name="refresh" size={18} /> Làm đề ngẫu nhiên</a>
          <a href={paths.exam(c.id, 1)} class="btn exam-hero-secondary">Bắt đầu đề số 1 <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
      <div class="exam-class-hero-decoration" aria-hidden="true"><Icon name="target" size={230} /></div>
    </div>
    <dl class="exam-class-stats">{facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>

    <div class="exam-section-heading exam-list-heading"><div><p class="exam-section-label">BỘ ĐỀ CỐ ĐỊNH</p><h2>20 đề thi thử hạng {c.id}</h2><p>Chọn một đề để làm bài. Điểm của bạn sẽ được lưu trên thiết bị này.</p></div></div>
    <ul class="exam-paper-grid">
      {
        exams.map((e) => (
          <li>
            <a href={paths.exam(c.id, e.id)} class="exam-paper-card">
              <span class="exam-paper-label">ĐỀ SỐ</span>
              <strong>{String(e.id).padStart(2, '0')}</strong>
              <span class="exam-paper-bottom"><ExamScoreBadge client:visible examKey={`${c.id}-${e.id}`} /><Icon name="arrow-right" size={17} /></span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="exam-info-grid">
      <div class="exam-info-card">
        <h2 class="text-lg font-bold">Cấu trúc đề thi hạng {c.id}</h2>
        <p class="mt-2 text-sm leading-relaxed text-soft">
          Đề gồm {c.exam.questionCount} câu lấy từ bộ 600 câu hỏi, chia theo 6 chương. Mỗi đề có câu điểm liệt: trả lời sai
          một câu điểm liệt là trượt ngay. Ôn trước theo từng chương:
        </p>
        <ul class="mt-3 space-y-1.5 text-sm">
          {
            CHAPTERS.map((ch) => (
              <li>
                <a href={paths.chapter(ch)} class="text-blue-600 hover:underline">
                  Chương {ch.numeral}. {ch.name}
                </a>
                <span class="text-muted"> ({ch.questionIds.length} câu)</span>
              </li>
            ))
          }
          <li><a href="/cau-diem-liet" class="text-blue-600 hover:underline">60 câu điểm liệt</a></li>
        </ul>
      </div>
      <div class="exam-faq-list">
        {
          faq.map((f) => (
            <details class="card group p-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
                {f.question}
                <Icon name="chevron-down" size={18} class="shrink-0 text-muted transition group-open:rotate-180" />
              </summary>
              <p class="mt-2 text-sm leading-relaxed text-soft">{f.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
