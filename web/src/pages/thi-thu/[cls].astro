---
import Base from '../../layouts/Base.astro';
import ExamTab from '../../components/ExamTab.astro';
import { RememberClass } from '../../components/HomeIslands';
import { CAR_CLASSES, LANDING_CLASSES, paths } from '../../lib/data';
import { classFaq, courseLd, faqLd } from '../../lib/faq';
import type { LicenseClass } from '../../lib/types';

export const getStaticPaths = () =>
  CAR_CLASSES.map((c) => ({ params: { cls: `hang-${c.id.toLowerCase()}` }, props: { c } }));

const { c } = Astro.props as { c: LicenseClass };
const landing = LANDING_CLASSES.some((x) => x.id === c.id);
const faq = classFaq(c);
const path = paths.licenseClass(c.id);
const heading = `Thi thử lý thuyết lái xe hạng ${c.id}`;
const description = `Thi thử lý thuyết bằng lái hạng ${c.id} (${c.title.toLowerCase()}): ${c.exam.questionCount} câu, ${c.exam.timeMinutes} phút, cần đúng ${c.exam.passingScore} câu. 20 đề có đáp án và đề ngẫu nhiên từ bộ 600 câu.`;
---

<Base
  title={`${heading}: ${c.exam.questionCount} câu, ${c.exam.timeMinutes} phút`}
  description={description}
  noindex={!landing}
  trail={[{ name: 'Thi thử', path: '/thi-thu' }, { name: `Hạng ${c.id}`, path }]}
  jsonLd={[courseLd(`Ôn thi lý thuyết lái xe hạng ${c.id}`, description, `${Astro.site!.origin}${path}`), faqLd(faq)]}
>
  <RememberClass client:load id={c.id} />
  <ExamTab c={c} />
</Base>
