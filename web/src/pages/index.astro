---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ClassBar, RoadmapCard, ExamCta, ChapterProgress } from '../components/HomeIslands';
import { CAR_CLASSES, CHAPTERS, CRITICAL_QUESTIONS, LANDING_CLASSES, QUESTIONS, SIGNS, paths } from '../lib/data';
import { TONES } from '../lib/icons';
import { HOME_FAQ, faqLd } from '../lib/faq';

const chapters = CHAPTERS.map((c) => ({ slug: c.slug, numeral: c.numeral, name: c.name, ids: c.questionIds }));
const shortcuts = [
  { href: '/on-tap', icon: 'book', tone: TONES.emerald, title: 'Ôn tập câu hỏi', detail: 'Toàn bộ 600 câu theo chương' },
  { href: '/on-tap/cau-diem-liet', icon: 'alert', tone: TONES.red, title: 'Câu điểm liệt', detail: `${CRITICAL_QUESTIONS.length} câu bắt buộc đúng` },
  { href: '/bien-bao', icon: 'sign', tone: TONES.amber, title: 'Biển báo', detail: `Tra cứu ${SIGNS.length} biển và vạch kẻ` },
  { href: '/meo-ghi-nho', icon: 'bulb', tone: TONES.sky, title: 'Mẹo ghi nhớ', detail: 'Mẹo làm nhanh, dễ nhớ' },
] as const;
---

<Base
  title="Ôn thi GPLX 600 câu lý thuyết lái xe ô tô 2026, thi thử miễn phí"
  description="Ôn thi lý thuyết bằng lái xe ô tô hạng B, C1, C, D: 600 câu hỏi có đáp án và giải thích, 60 câu điểm liệt, thi thử bấm giờ chấm điểm như thi thật, tra cứu biển báo. Miễn phí."
  jsonLd={[faqLd(HOME_FAQ)]}
>
  <section class="container-page pt-10 text-center sm:pt-14">
    <p class="chip mx-auto"><Icon name="shield" size={12} /> Bộ 600 câu hỏi sát hạch áp dụng từ 2025</p>
    <h1 class="mx-auto mt-4 max-w-3xl text-3xl font-extrabold leading-tight tracking-tight sm:text-5xl">
      Ôn thi lý thuyết lái xe{' '}
      <span class="bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent">đậu ngay lần đầu</span>
    </h1>
    <p class="mx-auto mt-3 max-w-xl text-muted">
      600 câu có đáp án và giải thích, thi thử bấm giờ như thi thật. Miễn phí, không cần đăng ký.
    </p>
    <div class="mt-7">
      <ClassBar client:load classes={CAR_CLASSES} total={QUESTIONS.length} />
    </div>
  </section>

  <section class="container-page mt-8 grid gap-4 lg:grid-cols-[1.45fr_1fr]">
    <RoadmapCard client:idle chapters={chapters} criticalIds={CRITICAL_QUESTIONS.map((q) => q.id)} />
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-strong via-blue-600 to-indigo-700 p-6 shadow-2xl shadow-blue-950/50 sm:p-7">
      <div class="grid size-11 place-items-center rounded-xl bg-white/15"><Icon name="clock" size={22} /></div>
      <h2 class="mt-5 text-2xl font-extrabold tracking-tight sm:text-3xl">Thi thử online</h2>
      <p class="mt-2 max-w-xs text-sm text-blue-100">
        20 đề cố định và đề ngẫu nhiên cho từng hạng, bấm giờ và chấm điểm theo đúng cấu trúc đề thật.
      </p>
      <ExamCta client:idle />
      <svg viewBox="0 0 200 200" class="pointer-events-none absolute -bottom-10 -right-8 w-52 text-white/10 sm:w-60" aria-hidden="true">
        <circle cx="110" cy="110" r="70" fill="none" stroke="currentColor" stroke-width="14"></circle>
        <path d="M110 70v40l26 16" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"></path>
        <rect x="92" y="20" width="36" height="18" rx="6" fill="currentColor"></rect>
      </svg>
    </div>
  </section>

  <section class="container-page mt-4">
    <ul class="card grid grid-cols-2 divide-line overflow-hidden lg:grid-cols-4 lg:divide-x">
      {
        shortcuts.map((s) => (
          <li>
            <a href={s.href} class="group flex h-full items-center gap-3 p-4 transition hover:bg-raised/60">
              <span class={`grid size-11 shrink-0 place-items-center rounded-xl ${s.tone}`}>
                <Icon name={s.icon} size={20} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold">{s.title}</span>
                <span class="block text-xs text-muted">{s.detail}</span>
              </span>
              <Icon name="arrow-right" size={16} class="hidden text-muted transition group-hover:translate-x-0.5 sm:block" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-page mt-14">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-sky-300">Ôn theo chương</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight">6 chương của bộ 600 câu</h2>
      </div>
      <a href="/600-cau-hoi" class="hidden text-sm font-semibold text-sky-300 hover:text-sky-200 sm:block">Xem cả 600 câu →</a>
    </div>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        CHAPTERS.map((c) => (
          <li class="card group relative p-5 transition hover:border-brand/40">
            <div class="flex items-start gap-3">
              <span class={`grid size-11 shrink-0 place-items-center rounded-xl ${TONES[c.tone]}`}>
                <Icon name={c.icon as any} size={20} />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-muted">Chương {c.numeral} · {c.range}</p>
                <h3 class="mt-0.5 font-bold leading-snug">
                  <a href={paths.practice(c.slug)} class="after:absolute after:inset-0">{c.name}</a>
                </h3>
              </div>
            </div>
            <ChapterProgress client:visible ids={c.questionIds} />
            <a href={paths.chapter(c)} class="relative z-10 mt-3 inline-block text-xs text-muted hover:text-sky-300">
              Xem đáp án chương {c.numeral}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-page mt-14">
    <p class="text-sm font-semibold text-sky-300">Thi thử theo hạng bằng</p>
    <h2 class="mt-1 text-2xl font-bold tracking-tight">Chọn hạng để vào đề</h2>
    <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        LANDING_CLASSES.map((c) => (
          <li>
            <a href={paths.licenseClass(c.id)} class="card block p-4 transition hover:border-brand/40 hover:bg-raised/60">
              <span class="text-2xl font-extrabold text-sky-300">{c.id}</span>
              <span class="mt-1 block text-xs text-soft">{c.title}</span>
              <span class="mt-3 block text-[11px] text-muted">
                {c.exam.questionCount} câu · {c.exam.timeMinutes} phút · đạt {c.exam.passingScore}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-page mt-14 grid gap-8 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="text-sm font-semibold text-sky-300">Hỏi đáp</p>
      <h2 class="mt-1 text-2xl font-bold tracking-tight">Câu hỏi thường gặp về thi lý thuyết</h2>
      <p class="mt-2 text-sm text-muted">
        Thi lý thuyết là bài đầu tiên khi thi bằng lái ô tô. Đề lấy từ bộ 600 câu, có câu điểm liệt, sai một câu điểm liệt là trượt.
      </p>
    </div>
    <div class="space-y-2">
      {
        HOME_FAQ.map((f) => (
          <details class="card group p-4 open:bg-raised/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
              {f.question}
              <Icon name="chevron-down" size={18} class="shrink-0 text-muted transition group-open:rotate-180" />
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-soft">{f.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>
