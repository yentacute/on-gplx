---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ClassChips, QuickExam, RoadmapCard, OverallProgress, ChapterProgress, WrongCount, SavedCount } from '../components/HomeIslands';
import { CAR_CLASSES, CHAPTERS, CRITICAL_QUESTIONS, QUESTIONS, SIGNS, paths } from '../lib/data';
import { TONES } from '../lib/icons';
import { HOME_FAQ, faqLd } from '../lib/faq';

const chapters = CHAPTERS.map((c) => ({ slug: c.slug, numeral: c.numeral, name: c.name, ids: c.questionIds }));
const saHinh = CHAPTERS.find((c) => c.slug === 'sa-hinh');
const tiles = [
  { href: '/on-tap/cau-diem-liet', icon: 'alert', tone: TONES.red, title: 'Câu điểm liệt', detail: `${CRITICAL_QUESTIONS.length} câu bắt buộc đúng` },
  { href: '/on-tap/cau-sai', icon: 'refresh', tone: TONES.amber, title: 'Câu hay sai', detail: null },
  { href: '/bien-bao', icon: 'sign', tone: TONES.violet, title: 'Biển báo', detail: `Tra cứu ${SIGNS.length} biển` },
  { href: '/meo-ghi-nho', icon: 'bulb', tone: TONES.sky, title: 'Mẹo ghi nhớ', detail: 'Mẹo làm nhanh, dễ nhớ' },
  ...(saHinh ? [{ href: paths.practice(saHinh.slug), icon: 'cross', tone: TONES.teal, title: 'Sa hình', detail: `${saHinh.questionIds.length} câu tình huống` } as const] : []),
  { href: '/600-cau-hoi', icon: 'clipboard', tone: TONES.emerald, title: '600 câu có đáp án', detail: 'Xem nhanh cả bộ đề' },
] as const;
---

<Base
  title="Ôn thi GPLX 600 câu lý thuyết lái xe ô tô 2026, thi thử miễn phí"
  description="Ôn thi lý thuyết bằng lái xe ô tô hạng B, C1, C, D: 600 câu hỏi có đáp án và giải thích, 60 câu điểm liệt, thi thử bấm giờ chấm điểm như thi thật, tra cứu biển báo. Miễn phí."
  jsonLd={[faqLd(HOME_FAQ)]}
>
  <!-- Hero banner -->
  <section class="container-page pt-5 sm:pt-8">
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-br from-blue-600 via-blue-600 to-indigo-700 px-5 py-7 text-white shadow-2xl shadow-blue-600/25 sm:px-10 sm:py-12">
      <div class="relative z-10 max-w-xl">
        <p class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold">
          <Icon name="shield" size={13} /> Bộ 600 câu sát hạch áp dụng từ 2025
        </p>
        <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight sm:text-[2.6rem]">
          Ôn thi lý thuyết lái xe, đậu ngay lần đầu
        </h1>
        <p class="mt-3 text-sm text-blue-100 sm:text-base">
          600 câu có đáp án và giải thích, thi thử bấm giờ như thi thật. Miễn phí, không cần đăng ký.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a href="/on-tap" class="btn bg-white text-blue-700 shadow-lg hover:bg-blue-50">
            <Icon name="book" size={16} /> Bắt đầu ôn tập
          </a>
          <a href="/thi-thu" class="btn bg-white/15 text-white ring-1 ring-white/30 hover:bg-white/25">
            <Icon name="clock" size={16} /> Thi thử
          </a>
        </div>
      </div>
      <svg viewBox="0 0 240 200" class="pointer-events-none absolute -bottom-6 right-6 hidden w-80 text-white/10 sm:block" aria-hidden="true">
        <path d="M200 140h20v-40l-26-52a20 20 0 0 0-18-11H64a20 20 0 0 0-18 11L20 100v40h20" fill="none" stroke="currentColor" stroke-width="14" stroke-linejoin="round"></path>
        <circle cx="70" cy="140" r="22" fill="currentColor"></circle>
        <circle cx="170" cy="140" r="22" fill="currentColor"></circle>
        <path d="M20 100h200" stroke="currentColor" stroke-width="12"></path>
      </svg>
    </div>
  </section>

  <!-- Class picker -->
  <section class="container-page mt-7">
    <h2 class="section-title">Bạn đang học hạng nào?</h2>
    <div class="mt-3">
      <ClassChips client:load classes={CAR_CLASSES} />
    </div>
  </section>

  <!-- What to study today -->
  <section class="container-page mt-8">
    <h2 class="section-title">Hôm nay bạn muốn học gì?</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <a href="/on-tap" class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-600 p-5 text-white shadow-xl shadow-emerald-600/20 sm:p-6">
        <span class="grid size-11 place-items-center rounded-2xl bg-white/20"><Icon name="book" size={22} /></span>
        <span class="mt-4 block text-xl font-bold">Ôn tập 600 câu</span>
        <span class="mt-1 block text-sm text-emerald-50">Theo 6 chương, có giải thích từng câu</span>
        <OverallProgress client:idle total={QUESTIONS.length} />
        <span class="absolute right-5 top-5 grid size-9 place-items-center rounded-full bg-white/20 transition group-hover:translate-x-0.5">
          <Icon name="arrow-right" size={16} />
        </span>
      </a>
      <a href="/thi-thu" class="group relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-600 to-indigo-600 p-5 text-white shadow-xl shadow-blue-600/20 sm:p-6">
        <span class="grid size-11 place-items-center rounded-2xl bg-white/20"><Icon name="clock" size={22} /></span>
        <span class="mt-4 block text-xl font-bold">Thi thử có bấm giờ</span>
        <span class="mt-1 block text-sm text-blue-100">20 đề cố định và đề ngẫu nhiên cho từng hạng</span>
        <span class="mt-4 flex flex-wrap gap-1.5 text-xs font-semibold">
          <span class="rounded-full bg-white/15 px-2.5 py-1">Chấm điểm ngay</span>
          <span class="rounded-full bg-white/15 px-2.5 py-1">Xem lại câu sai</span>
        </span>
        <span class="absolute right-5 top-5 grid size-9 place-items-center rounded-full bg-white/20 transition group-hover:translate-x-0.5">
          <Icon name="arrow-right" size={16} />
        </span>
      </a>
    </div>

    <ul class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiles.map((t) => (
          <li>
            <a href={t.href} class="tile group h-full">
              <span class={`grid size-11 shrink-0 place-items-center rounded-2xl ${t.tone}`}>
                <Icon name={t.icon} size={20} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-[15px] font-bold">{t.title}</span>
                <span class="block truncate text-xs text-muted">{t.detail ?? <WrongCount client:idle />}</span>
              </span>
              <span class="tile-arrow group-hover:bg-brand group-hover:text-white">
                <Icon name="arrow-right" size={15} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <a href="/on-tap/cau-da-luu" class="tile group mt-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-amber-400/20 text-amber-700">
        <Icon name="bookmark" size={20} />
      </span>
      <span class="min-w-0 flex-1">
        <span class="block text-[15px] font-bold">Câu đã lưu</span>
        <span class="block truncate text-xs text-muted"><SavedCount client:idle /></span>
      </span>
      <span class="tile-arrow group-hover:bg-brand group-hover:text-white"><Icon name="arrow-right" size={15} /></span>
    </a>
  </section>

  <!-- Quick exam for the selected class -->
  <section class="container-page mt-8">
    <h2 class="section-title">Thi thử nhanh</h2>
    <div class="mt-3">
      <QuickExam client:idle classes={CAR_CLASSES} />
    </div>
  </section>

  <!-- Roadmap -->
  <section class="container-page mt-8">
    <RoadmapCard client:idle chapters={chapters} criticalIds={CRITICAL_QUESTIONS.map((q) => q.id)} />
  </section>

  <!-- Chapters -->
  <section class="container-page mt-10">
    <div class="flex items-end justify-between gap-4">
      <h2 class="section-title">Ôn theo 6 chương</h2>
      <a href="/600-cau-hoi" class="text-sm font-semibold text-blue-600 hover:text-blue-700">Xem cả 600 câu</a>
    </div>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        CHAPTERS.map((c) => (
          <li class="card group relative p-5 transition hover:-translate-y-0.5 hover:border-brand/40">
            <div class="flex items-start gap-3">
              <span class={`grid size-11 shrink-0 place-items-center rounded-2xl ${TONES[c.tone]}`}>
                <Icon name={c.icon as any} size={20} />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-muted">Chương {c.numeral} · {c.range}</p>
                <h3 class="mt-0.5 font-bold leading-snug">
                  <a href={paths.practice(c.slug)} class="after:absolute after:inset-0">{c.name}</a>
                </h3>
              </div>
            </div>
            <ChapterProgress client:visible ids={c.questionIds} />
            <a href={paths.chapter(c)} class="relative z-10 mt-3 inline-block text-xs text-muted hover:text-blue-600">
              Xem đáp án chương {c.numeral}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- FAQ -->
  <section class="container-page mt-10 grid gap-6 lg:grid-cols-[1fr_1.5fr]">
    <div>
      <h2 class="section-title">Câu hỏi thường gặp</h2>
      <p class="mt-2 text-sm text-muted">
        Thi lý thuyết là bài đầu tiên khi thi bằng lái ô tô. Đề lấy từ bộ 600 câu, có câu điểm liệt, sai một câu điểm liệt là trượt.
      </p>
    </div>
    <div class="space-y-2">
      {
        HOME_FAQ.map((f) => (
          <details class="card group rounded-2xl p-4 open:bg-white">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
              {f.question}
              <Icon name="chevron-down" size={18} class="shrink-0 text-muted transition group-open:rotate-180" />
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-soft">{f.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>
