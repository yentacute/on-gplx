---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { RoadmapCard, ExamCta, ChapterProgress } from '../components/HomeIslands';
import { CHAPTERS, CRITICAL_QUESTIONS, SIGNS, paths } from '../lib/data';
import { TONES } from '../lib/icons';
import { HOME_FAQ, faqLd } from '../lib/faq';

const chapters = CHAPTERS.map((c) => ({ slug: c.slug, numeral: c.numeral, name: c.name, ids: c.questionIds }));
const shortcuts = [
  { href: '/on-tap', icon: 'book', accent: 'blue', title: 'Ôn 600 câu hỏi', detail: 'Học theo chương, xem giải thích', label: 'HỌC LÝ THUYẾT', action: 'Bắt đầu ôn' },
  { href: '/cau-diem-liet', icon: 'alert', accent: 'red', title: 'Câu điểm liệt', detail: `${CRITICAL_QUESTIONS.length} câu quan trọng cần nắm chắc`, label: 'CẦN NẮM CHẮC', action: 'Ôn câu điểm liệt' },
  { href: '/bien-bao', icon: 'sign', accent: 'green', title: 'Biển báo giao thông', detail: `Tra cứu ${SIGNS.length} biển và vạch kẻ`, label: 'TRA CỨU NHANH', action: 'Xem biển báo' },
  { href: '/meo-ghi-nho', icon: 'bulb', accent: 'orange', title: 'Mẹo ghi nhớ', detail: 'Gợi ý ngắn, dễ nhớ và dễ áp dụng', label: 'HỌC NHANH HƠN', action: 'Xem mẹo học' },
] as const;
---

<Base
  title="Ôn thi GPLX 600 câu lý thuyết lái xe ô tô 2026, thi thử miễn phí"
  description="Ôn thi lý thuyết bằng lái xe ô tô hạng B, C1, C, D: 600 câu hỏi có đáp án và giải thích, 60 câu điểm liệt, thi thử bấm giờ chấm điểm như thi thật, tra cứu biển báo. Miễn phí."
  jsonLd={[faqLd(HOME_FAQ)]}
>
  <section class="home-hero">
    <div class="container-page home-hero-grid">
      <div class="home-hero-copy">
        <p class="home-eyebrow"><span></span> ÔN THI GPLX 2026 · MIỄN PHÍ</p>
        <h1>Học chắc lý thuyết.<br /><em>Vững vàng vào phòng thi.</em></h1>
        <p class="home-hero-lead">600 câu hỏi có giải thích, ôn theo từng chương và luyện đề sát cấu trúc thi thật. Bắt đầu ngay, không cần đăng ký.</p>
        <div class="home-hero-actions"><a href="/on-tap" class="home-button home-button-primary">Bắt đầu ôn tập <Icon name="arrow-right" size={18} /></a><a href="/thi-thu" class="home-button home-button-light"><Icon name="clock" size={18} /> Thi thử ngay</a></div>
        <div class="home-hero-points"><span><Icon name="check" size={15} /> Học miễn phí</span><span><Icon name="check" size={15} /> Lưu tiến độ</span><span><Icon name="check" size={15} /> Dùng trên mọi thiết bị</span></div>
      </div>
      <div class="home-hero-visual" aria-hidden="true">
        <div class="home-visual-orbit"></div>
        <div class="home-preview-card"><div class="home-preview-top"><span><Icon name="car" size={21} /></span><b>Hành trình chinh phục GPLX</b><small>•••</small></div><div class="home-preview-body"><span class="home-preview-tag">BỘ CÂU HỎI LÝ THUYẾT</span><strong>Hôm nay học một chút,<br />ngày thi tự tin hơn.</strong><div class="home-preview-stats"><span><b>600</b><small>câu hỏi</small></span><span><b>20</b><small>đề thi</small></span><span><b>6</b><small>chương học</small></span></div><div class="home-preview-options"><span><Icon name="book" size={18} /> Ôn tập theo chương</span><span><Icon name="target" size={18} /> Luyện đề thi thử</span></div></div></div>
        <div class="home-float-note"><span><Icon name="shield" size={20} /></span><div><b>Học đúng trọng tâm</b><small>Ôn từng bước, nhớ lâu hơn</small></div></div>
      </div>
    </div>
  </section>

  <section class="container-page home-section home-activities-section">
    <div class="home-section-heading"><div><p class="home-kicker">HỌC THEO CÁCH CỦA BẠN</p><h2>Hôm nay bạn muốn học gì?</h2><p>Chọn một nội dung và bắt đầu ngay.</p></div></div>
    <ul class="home-activity-grid">{shortcuts.map((s) => <li><a href={s.href} class="home-activity-card" data-accent={s.accent}><span class="home-activity-icon"><Icon name={s.icon} size={27} /></span><span class="home-activity-label">{s.label}</span><strong>{s.title}</strong><span class="home-activity-detail">{s.detail}</span><span class="home-activity-action">{s.action} <Icon name="arrow-right" size={16} /></span></a></li>)}</ul>
  </section>

  <section class="container-page home-section home-plan-section" aria-label="Lộ trình ôn tập và thi thử">
    <div class="home-plan-grid">
    <RoadmapCard client:idle chapters={chapters} criticalIds={CRITICAL_QUESTIONS.map((q) => q.id)} />
    <div class="home-exam-panel">
      <div class="home-exam-icon"><Icon name="clock" size={24} /></div>
      <p class="home-exam-overline">LUYỆN NHƯ THI THẬT</p>
      <h2>Đã học rồi?<br />Thử sức với một đề thi.</h2>
      <p>20 đề cố định và đề ngẫu nhiên cho từng hạng bằng. Làm bài có bấm giờ, nộp bài là biết kết quả.</p>
      <ExamCta client:idle />
      <div class="home-exam-shape" aria-hidden="true"><Icon name="target" size={200} /></div>
    </div>
    </div>
  </section>

  <section class="container-page home-section home-chapters-section">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="home-kicker">HỌC TỪNG PHẦN</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#142d50] sm:text-3xl">6 chương của bộ 600 câu</h2>
      </div>
      <a href="/600-cau-hoi" class="hidden text-sm font-semibold text-blue-600 hover:text-blue-700 sm:block">Xem cả 600 câu →</a>
    </div>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        CHAPTERS.map((c) => (
          <li class="card home-chapter-card group relative rounded-[18px] p-5 shadow-sm transition hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-blue-900/10">
            <div class="flex items-start gap-3">
              <span class={`grid size-11 shrink-0 place-items-center rounded-xl ${TONES[c.tone]}`}>
                <Icon name={c.icon as any} size={20} />
              </span>
              <div class="min-w-0">
                <p class="text-xs font-semibold text-muted">Chương {c.numeral} · {c.range}</p>
                <h3 class="mt-0.5 font-bold leading-snug">
                  <a href={paths.practice(c.slug)} class="after:absolute after:inset-0">{c.name}</a>
                </h3>
              </div>
            </div>
            <ChapterProgress client:visible ids={c.questionIds} />
            <a href={paths.chapter(c)} class="relative z-10 mt-3 inline-block text-xs text-muted hover:text-blue-600">
              Xem đáp án chương {c.numeral}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container-page home-section grid gap-8 lg:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="home-kicker">GIẢI ĐÁP NHANH</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-[#142d50] sm:text-3xl">Câu hỏi thường gặp</h2>
      <p class="mt-2 text-sm text-muted">
        Thi lý thuyết là bài đầu tiên khi thi bằng lái ô tô. Đề lấy từ bộ 600 câu, có câu điểm liệt, sai một câu điểm liệt là trượt.
      </p>
    </div>
    <div class="space-y-2">
      {
        HOME_FAQ.map((f) => (
          <details class="card home-faq-card group p-4 open:bg-raised/60">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-semibold">
              {f.question}
              <Icon name="chevron-down" size={18} class="shrink-0 text-muted transition group-open:rotate-180" />
            </summary>
            <p class="mt-2 text-sm leading-relaxed text-soft">{f.answer}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>
