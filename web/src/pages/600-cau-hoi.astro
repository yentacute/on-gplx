---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CHAPTERS, QUESTIONS, clip, paths, questionById } from '../lib/data';
---

<Base
  title="600 câu hỏi lý thuyết lái xe ô tô có đáp án"
  description="Danh sách đủ 600 câu hỏi sát hạch lý thuyết lái xe ô tô, chia theo 6 chương. Bấm vào từng câu để xem đáp án đúng và giải thích."
  trail={[{ name: '600 câu hỏi', path: paths.allQuestions }]}
>
  <section class="container-page pt-4">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">600 câu hỏi lý thuyết lái xe</h1>
    <p class="mt-2 max-w-2xl text-muted">Bộ câu hỏi dùng chung cho các hạng ô tô. Bấm vào câu để xem đáp án và giải thích.</p>
    <a href="/on-tap/tat-ca" class="btn btn-primary mt-4">Ôn tập lần lượt <Icon name="arrow-right" size={16} /></a>
    {
      CHAPTERS.map((c) => (
        <section class="mt-10">
          <h2 class="text-lg font-bold">
            <a href={paths.chapter(c)} class="hover:text-sky-300">Chương {c.numeral}. {c.name}</a>
            <span class="text-sm font-normal text-muted"> · {c.range}</span>
          </h2>
          <ol class="mt-3 grid gap-x-6 gap-y-1 text-sm sm:grid-cols-2">
            {c.questionIds.map((id) => {
              const q = questionById(id)!;
              return (
                <li class="flex gap-2 border-b border-line py-1.5">
                  <span class="w-9 shrink-0 text-right font-semibold tabular-nums text-muted">{id}.</span>
                  <a href={paths.question(id)} class="text-soft hover:text-sky-300">{clip(q.text, 90)}</a>
                  {q.critical && <span class="ml-auto shrink-0 text-xs font-semibold text-red-300">Điểm liệt</span>}
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }
    <p class="sr-only">{QUESTIONS.length} câu</p>
  </section>
</Base>
