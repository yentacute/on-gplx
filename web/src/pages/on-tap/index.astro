---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import { ChapterProgress, WrongCount, SavedCount } from '../../components/HomeIslands';
import { CHAPTERS, CRITICAL_QUESTIONS, QUESTIONS, paths } from '../../lib/data';
import { TONES } from '../../lib/icons';
---

<Base
  title="Ôn tập 600 câu lý thuyết lái xe theo chương"
  description="Ôn tập lý thuyết lái xe ô tô theo 6 chương của bộ 600 câu, luyện 60 câu điểm liệt và làm lại các câu hay sai. Có đáp án và giải thích từng câu."
  trail={[{ name: 'Ôn tập', path: '/on-tap' }]}
>
  <section class="container-page exam-page">
    <PageHero
      kicker="ÔN TẬP LÝ THUYẾT"
      kickerIcon="book"
      title="Ôn 600 câu theo chương,"
      highlight="hiểu đến đâu, nhớ đến đó"
      lead="Bấm vào đáp án là biết ngay đúng sai kèm giải thích. Tiến độ được lưu lại, lần sau ôn tiếp từ câu chưa làm."
      facts={[
        { icon: 'grid', label: `${CHAPTERS.length} chương` },
        { icon: 'alert', label: `${CRITICAL_QUESTIONS.length} câu điểm liệt` },
        { icon: 'bookmark', label: 'Lưu câu khó' },
      ]}
      ringIcon="book"
      ticket={{ label: 'GỢI Ý HỌC', icon: 'target', title: 'Điểm liệt trước<br />rồi ôn từng chương', note: 'Câu sai sẽ được gom lại để luyện lại' }}
    />

    <div class="exam-section-heading">
      <div>
        <p class="exam-section-label">LUYỆN NHANH</p>
        <h2>Bắt đầu từ đâu?</h2>
      </div>
    </div>
    <ul class="study-shortcuts">
      <li>
        <a href="/on-tap/cau-diem-liet" class="study-tile">
          <span class={`study-tile-icon ${TONES.red}`}><Icon name="alert" size={22} /></span>
          <span class="min-w-0"><strong>Câu điểm liệt</strong><small>{CRITICAL_QUESTIONS.length} câu, sai một câu là trượt</small></span>
          <span class="study-tile-arrow"><Icon name="arrow-right" size={15} /></span>
        </a>
      </li>
      <li>
        <a href="/on-tap/cau-sai" class="study-tile">
          <span class={`study-tile-icon ${TONES.amber}`}><Icon name="refresh" size={22} /></span>
          <span class="min-w-0"><strong>Câu hay sai</strong><small><WrongCount client:load /></small></span>
          <span class="study-tile-arrow"><Icon name="arrow-right" size={15} /></span>
        </a>
      </li>
      <li>
        <a href="/on-tap/cau-da-luu" class="study-tile">
          <span class={`study-tile-icon ${TONES.violet}`}><Icon name="bookmark" size={22} /></span>
          <span class="min-w-0"><strong>Câu đã lưu</strong><small><SavedCount client:load /></small></span>
          <span class="study-tile-arrow"><Icon name="arrow-right" size={15} /></span>
        </a>
      </li>
      <li>
        <a href="/on-tap/tat-ca" class="study-tile">
          <span class={`study-tile-icon ${TONES.sky}`}><Icon name="grid" size={22} /></span>
          <span class="min-w-0"><strong>Toàn bộ {QUESTIONS.length} câu</strong><small>Ôn lần lượt từ câu 1</small></span>
          <span class="study-tile-arrow"><Icon name="arrow-right" size={15} /></span>
        </a>
      </li>
    </ul>

    <div class="exam-section-heading">
      <div>
        <p class="exam-section-label">THEO CHƯƠNG</p>
        <h2>Ôn tập theo chương</h2>
        <p>Mỗi chương là một nhóm kiến thức. Làm hết một chương rồi chuyển sang chương sau.</p>
      </div>
    </div>
    <ul class="chapter-rows">
      {
        CHAPTERS.map((c, i) => (
          <li class="chapter-row">
            <span class="chapter-row-num">{i + 1}</span>
            <div class="min-w-0 flex-1">
              <h3>
                <a href={paths.practice(c.slug)} class="after:absolute after:inset-0">
                  Chương {c.numeral}: {c.name}
                </a>
              </h3>
              <p class="chapter-row-meta">
                {c.questionIds.length} câu hỏi · {c.range}
              </p>
              <ChapterProgress client:visible ids={c.questionIds} />
              <p class="chapter-row-links">
                <a href={paths.practice(c.slug)} class="inline-flex items-center gap-1 text-blue-600">
                  Ôn tập <Icon name="chevron-right" size={14} />
                </a>
                <a href={paths.chapter(c)} class="text-muted hover:text-blue-600">Xem đáp án</a>
              </p>
            </div>
            <span class={`hidden size-10 shrink-0 place-items-center rounded-xl sm:grid ${TONES[c.tone]}`}>
              <Icon name={c.icon as any} size={19} />
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
