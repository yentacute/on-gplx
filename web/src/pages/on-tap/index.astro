---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { ChapterProgress, WrongCount } from '../../components/HomeIslands';
import { CHAPTERS, CRITICAL_QUESTIONS, QUESTIONS, paths } from '../../lib/data';
import { TONES } from '../../lib/icons';
---

<Base
  title="Ôn tập 600 câu lý thuyết lái xe theo chương"
  description="Ôn tập lý thuyết lái xe ô tô theo 6 chương của bộ 600 câu, luyện 60 câu điểm liệt và làm lại các câu hay sai. Có đáp án và giải thích từng câu."
  trail={[{ name: 'Ôn tập', path: '/on-tap' }]}
>
  <section class="container-page pt-6">
    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Ôn tập lý thuyết</h1>
    <p class="mt-1 text-muted">Chọn chương để bắt đầu. Bấm vào đáp án là biết ngay đúng sai kèm giải thích.</p>

    <div class="mt-6 grid gap-3 sm:grid-cols-3">
      <a href="/on-tap/cau-diem-liet" class="card group flex items-center gap-3 p-4 transition hover:border-red-400/40">
        <span class={`grid size-11 place-items-center rounded-xl ${TONES.red}`}><Icon name="alert" /></span>
        <span class="flex-1">
          <span class="block font-bold">Câu điểm liệt</span>
          <span class="block text-xs text-muted">{CRITICAL_QUESTIONS.length} câu, sai một câu là trượt</span>
        </span>
        <Icon name="chevron-right" size={16} class="text-muted" />
      </a>
      <a href="/on-tap/cau-sai" class="card group flex items-center gap-3 p-4 transition hover:border-amber-400/40">
        <span class={`grid size-11 place-items-center rounded-xl ${TONES.amber}`}><Icon name="refresh" /></span>
        <span class="flex-1">
          <span class="block font-bold">Câu hay sai</span>
          <span class="block text-xs text-muted"><WrongCount client:load>Câu đã làm sai</WrongCount></span>
        </span>
        <Icon name="chevron-right" size={16} class="text-muted" />
      </a>
      <a href="/on-tap/tat-ca" class="card group flex items-center gap-3 p-4 transition hover:border-brand/40">
        <span class={`grid size-11 place-items-center rounded-xl ${TONES.sky}`}><Icon name="grid" /></span>
        <span class="flex-1">
          <span class="block font-bold">Toàn bộ {QUESTIONS.length} câu</span>
          <span class="block text-xs text-muted">Ôn lần lượt từ câu 1</span>
        </span>
        <Icon name="chevron-right" size={16} class="text-muted" />
      </a>
    </div>

    <h2 class="mt-10 text-lg font-bold">Theo chương</h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        CHAPTERS.map((c) => (
          <li class="card relative p-5 transition hover:border-brand/40">
            <div class="flex items-start justify-between gap-3">
              <span class="chip">Chương {c.numeral}</span>
              <span class={`grid size-9 place-items-center rounded-lg ${TONES[c.tone]}`}>
                <Icon name={c.icon as any} size={18} />
              </span>
            </div>
            <h3 class="mt-3 font-bold leading-snug">
              <a href={paths.practice(c.slug)} class="after:absolute after:inset-0">{c.name}</a>
            </h3>
            <p class="text-xs text-muted">{c.questionIds.length} câu hỏi · {c.range}</p>
            <ChapterProgress client:visible ids={c.questionIds} />
            <p class="mt-3 flex items-center gap-1 text-sm font-semibold text-blue-600">
              Bắt đầu ôn tập <Icon name="chevron-right" size={14} />
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
