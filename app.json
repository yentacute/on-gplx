{
  "expo": {
    "name": "Ôn thi GPLX",
    "slug": "gplx-app",
    "owner": "sammy2309",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gplx",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sammy2309.gplx"
    },
    "android": {
      "package": "com.sammy2309.gplx",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563eb"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f6487910-d2a2-4120-aa4f-0d716561ad60"
      }
    }
  }
}
